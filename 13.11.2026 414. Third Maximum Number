class Solution {
    public int thirdMax(int[] nums) {
        HashSet<Integer> set=new HashSet<>();
        for(int num:nums){
            set.add(num);
        }
        int[] arr=new int[set.size()];
        int index=0;
        for(int num:set){
            arr[index]=num;
            index++;
        }
        for(int i=0;i<arr.length-1;i++){
            for(int j=i+1;j>0;j--){
                if(arr[j]<arr[j-1]){
                    swap(arr,j,j-1);
                }
                else{
                    break;
                }
            }
        }
        
        int max=Integer.MIN_VALUE;
        if(arr.length>=3){
            return arr[arr.length-3];
        }
        else{
            for(int i=arr.length-1;i>=0;i--){
                if(max<arr[i]){
                    max=arr[i];
                }
            }
            return max;
        }

    }

    static void swap(int[] arr,int start,int end){
        int temp=arr[start];
        arr[start]=arr[end];
        arr[end]=temp;
    }
}

class Solution {
    public boolean checkIfPangram(String sentence) {
        boolean[] arr=new boolean[26];
        if(sentence.length()<26){
            return false;
        }
        for(int i=0;i<sentence.length();i++){
            char ch=sentence.charAt(i);
            int index=ch-'a';
            if(arr[index]!=true){
                arr[index]=true;
            }
        }
        for(int i = 0; i < arr.length; i++){
            if(arr[i] == false){
                return false;
            }
        }
        return true;
    }
}

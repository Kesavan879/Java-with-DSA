class Solution {
    public int averageValue(int[] nums) {
        int count=0;
        int add=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]%2==0&&nums[i]%3==0){
                count++;
                add+=nums[i];
            }
        }
        if(count==0){
            return 0;
        }
       // int avg=add/count;
        return add/count;
    }
}

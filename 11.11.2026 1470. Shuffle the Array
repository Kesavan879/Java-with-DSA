class Solution {
    public int[] shuffle(int[] nums, int n) {
        ArrayList<Integer>list=new ArrayList<>();
        int[] arr1=new int[n];
        int[] arr2=new int[n];
        for(int i=0;i<arr1.length;i++){
            arr1[i]=nums[i];
        }
        int index=0;
        for(int i=n;i<nums.length;i++){
            arr2[index]=nums[i];
            index++;
        }
        for(int i=0;i<arr1.length;i++){
            list.add(arr1[i]);
            list.add(arr2[i]);
        }
        int[] arr=new int[nums.length];
        int i=0;
        for(int num:list){
            arr[i]=num;
            i++;
        }
        return arr;
    }
}

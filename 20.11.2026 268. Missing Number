class Solution {
    public int missingNumber(int[] nums) {
        for(int i=0;i<nums.length;i++){
            boolean swap=false;
            for(int j=1;j<nums.length;j++){
                if(nums[j]<nums[j-1]){
                    int temp=nums[j];
                    nums[j]=nums[j-1];
                    nums[j-1]=temp;
                    swap=true;
                }
            }
            if(!swap){
                break;
            }
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=i){
                return i;
            }
        }
        return nums.length;
    }
}

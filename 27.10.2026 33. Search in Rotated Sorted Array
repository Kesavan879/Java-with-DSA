class Solution {
    public int search(int[] nums, int target) {
        int large=find(nums);
        if(large==-1){
            return binary(nums,target,0,nums.length-1);
        }
        if(nums[large]==target){
            return large;
        }
        if(target>=nums[0]){
            return binary(nums,target,0,large-1);
        }
        else{
            return binary(nums,target,large+1,nums.length-1);
        }
    }
   
    static int binary(int[] nums,int target,int start,int end){
        while(start<=end){
            int mid=start+(end-start)/2;
            if(target<nums[mid]){
                end=mid-1;
            }
            else if(target>nums[mid]){
                start=mid+1;
            }
            else{
                return mid;
            }
        }
        return -1;
    }    


    static int find(int[] nums){
        int start=0;
        int end=nums.length-1;
        while(start<=end){
            int mid=start+(end-start)/2;
            if(mid<end&&nums[mid]>nums[mid+1]){
                return mid;
            }
            else if(mid>start&&nums[mid]<nums[mid-1]){
                return mid-1;
            }
            if(nums[mid]<=nums[start]){
                end=mid-1;
            }
            else{
                start=mid+1;
            }
        }
        return -1;
    }
}

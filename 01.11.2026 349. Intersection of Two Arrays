class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        HashSet<Integer> set=new HashSet<>();
        ArrayList<Integer> list=new ArrayList<>();
        for(int num:nums1){
            set.add(num);
        }
        int s2=0;
        int e2=nums2.length-1;
        while(s2<=e2){
            if(set.contains(nums2[s2])){
                set.remove(nums2[s2]);
                list.add(nums2[s2]);
                s2++;
            }
            else{
                s2++;
            }
        }
        int[] arr=new int[list.size()];
        int index=0;
        for(int num:list){
            arr[index]=num;
            index++;
        }
        return arr;
    }
}
